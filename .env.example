# Jumpchain Engine V1 - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# Anthropic (Claude) - Get your key at: https://console.anthropic.com/
# Required for: Master narrator (Tier 3), deep shadow work
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Z.AI (GLM models) - Get your key at: https://bigmodel.cn/
# Required for: Analytical tier (Tier 2) with GLM 4.6
ZAI_API_KEY=your_zai_api_key_here

# OpenRouter - Get your key at: https://openrouter.ai/
# Optional: Alternative for accessing multiple models through one API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# LM Studio (Local Models)
# ============================================================================

# LM Studio local endpoint (default: http://localhost:1234/v1)
# No API key needed for local models
# Download LM Studio at: https://lmstudio.ai/
LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# ============================================================================
# Database Configuration
# ============================================================================

# Database path (default: data/jumpchain.db)
DATABASE_PATH=data/jumpchain.db

# ============================================================================
# Cost Management
# ============================================================================

# Monthly budget limit in USD (optional, for alerts)
MONTHLY_BUDGET_LIMIT=50.00

# Auto-confirm for calls under this cost (default: 0.01)
AUTO_CONFIRM_THRESHOLD=0.01

# ============================================================================
# Development Settings
# ============================================================================

# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Mock API calls for testing (true/false)
MOCK_API_CALLS=false

# ============================================================================
# Optional: Custom Model Endpoints
# ============================================================================

# Override default model names (advanced usage)
# GLM_4_AIR_MODEL=glm-4-air
# GLM_4_6_MODEL=glm-4.6
# CLAUDE_SONNET_MODEL=claude-sonnet-4-5

# ============================================================================
# Notes
# ============================================================================
#
# 1. Never commit your .env file to version control
# 2. Keep your API keys secure
# 3. Rotate keys regularly
# 4. Use different keys for development and production
# 5. Monitor your API usage to stay within budget
#
# For more information, see: README.md
